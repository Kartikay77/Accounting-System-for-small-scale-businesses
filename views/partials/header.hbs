<body>
<header class="topbar">
  <a class="brand" href="/home"><span>Easy</span> Accounting</a>
  <div class="topbar-actions">
    {{#if userName}}
      <span class="muted">{{userName}}</span>
      {{#if availableCompanies.length}}
      <details class="company-menu">
        <summary>{{#if companyName}}{{companyName}}{{else}}Select company{{/if}}</summary>
        <div class="company-menu-list">
          {{#each availableCompanies}}
          <form method="post" action="/company/select">
            <input type="hidden" name="companyId" value="{{this._id}}">
            <button type="submit">{{this.name}}</button>
          </form>
          {{/each}}
        </div>
      </details>
      {{/if}}
      <form method="post" action="/logout" class="inline-form">
        <button class="btn btn-outline" type="submit">Logout</button>
      </form>
    {{else}}
      <a class="btn btn-outline" href="/login">Login</a>
      <a class="btn" href="/register">Register</a>
    {{/if}}
  </div>
</header>
