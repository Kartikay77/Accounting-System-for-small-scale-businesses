{{> static}}{{> header}}{{> sidebar}}<main class="page-content"><div class="page-heading"><div><h1>Accounts Receivable</h1><p class="muted">Track customer balances and post cash/bank receipts against invoices.</p></div></div><section class="panel table-wrap"><h2>Customer invoices</h2><table><thead><tr><th>Invoice</th><th>Customer</th><th>Date</th><th>Total</th><th>Paid</th><th>Due</th><th>Status</th><th>Receive</th></tr></thead><tbody>{{#each rows}}<tr><td>{{number}}</td><td>{{partyName}}</td><td>{{dateText}}</td><td>₹{{totalText}}</td><td>₹{{paidText}}</td><td>₹{{dueText}}</td><td>{{status}}</td><td><form method="post" action="/accounting/ar/{{_id}}/receive" class="inline-form"><input class="form-control" type="date" name="date" required><input class="form-control" type="number" min="0.01" step="0.01" name="amount" placeholder="Amount" required><select class="form-control" name="mode"><option>BANK_TRANSFER</option><option>CASH</option><option>UPI</option><option>CHEQUE</option><option>CARD</option><option>OTHER</option></select><input class="form-control" name="reference" placeholder="Reference"><button class="btn btn-outline" type="submit">Receive</button></form></td></tr>{{else}}<tr><td colspan="8">No customer invoices yet.</td></tr>{{/each}}</tbody></table></section><section class="panel table-wrap"><h2>Recent receipts</h2><table><thead><tr><th>Date</th><th>Customer</th><th>Mode</th><th>Reference</th><th>Amount</th></tr></thead><tbody>{{#each paymentRows}}<tr><td>{{dateText}}</td><td>{{partyName}}</td><td>{{mode}}</td><td>{{reference}}</td><td>₹{{amountText}}</td></tr>{{else}}<tr><td colspan="5">No receipts posted yet.</td></tr>{{/each}}</tbody></table></section></main>{{> footer}}