{{> static}}{{> header}}{{> sidebar}}<main class="page-content"><div class="page-heading"><div><h1>Bank Reconciliation</h1><p class="muted">Enter bank-statement lines and match them to posted bank journal movements.</p></div></div><section class="panel"><h2>Add statement transaction</h2><form method="post" action="/accounting/bank-reconciliation/new" class="form-grid"><label>Date<input class="form-control" type="date" name="date" required></label><label>Description<input class="form-control" name="description"></label><label>Reference<input class="form-control" name="reference"></label><label>Amount<input class="form-control" type="number" step="0.01" name="amount" required><small>Use positive for deposits and negative for withdrawals.</small></label><div class="actions"><button class="btn" type="submit">Add transaction</button></div></form></section><section class="panel table-wrap"><h2>Statement transactions</h2><table><thead><tr><th>Date</th><th>Description</th><th>Reference</th><th>Amount</th><th>Status</th><th>Match</th></tr></thead><tbody>{{#each transactions}}<tr><td>{{dateText}}</td><td>{{description}}</td><td>{{reference}}</td><td>₹{{amountText}}</td><td>{{status}}</td><td>{{#unless matchedJournalEntryId}}<form method="post" action="/accounting/bank-reconciliation/{{_id}}/match" class="inline-form"><select class="form-control" name="journalEntryId" required><option value="">Select journal movement</option>{{#each ../journals}}<option value="{{_id}}">{{dateText}} · {{referenceType}} · {{description}} · ₹{{amountText}}</option>{{/each}}</select><button class="btn btn-outline" type="submit">Match</button></form>{{else}}Matched{{/unless}}</td></tr>{{else}}<tr><td colspan="6">No statement transactions yet.</td></tr>{{/each}}</tbody></table></section></main>{{> footer}}