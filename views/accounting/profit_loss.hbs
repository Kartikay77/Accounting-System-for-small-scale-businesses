{{> static}}{{> header}}{{> sidebar}}<main class="page-content"><div class="page-heading"><div><h1>Profit & Loss</h1><p class="muted">Revenue less expenses for the selected period.</p></div></div><form class="panel form-grid" method="get"><label>From<input class="form-control" type="date" name="from" value="{{from}}"></label><label>To<input class="form-control" type="date" name="to" value="{{to}}"></label><div class="actions"><button class="btn" type="submit">Filter</button></div></form><div class="two-column"><section class="panel"><h2>Revenue</h2><table><tbody>{{#each revenue}}<tr><td>{{code}} · {{name}}</td><td>₹{{balanceText}}</td></tr>{{else}}<tr><td>No revenue posted</td><td>₹0.00</td></tr>{{/each}}<tr><th>Total revenue</th><th>₹{{revenueTotal}}</th></tr></tbody></table></section><section class="panel"><h2>Expenses</h2><table><tbody>{{#each expenses}}<tr><td>{{code}} · {{name}}</td><td>₹{{balanceText}}</td></tr>{{else}}<tr><td>No expenses posted</td><td>₹0.00</td></tr>{{/each}}<tr><th>Total expenses</th><th>₹{{expenseTotal}}</th></tr></tbody></table></section></div><section class="panel"><h2>Net income</h2><p class="metric">₹{{netIncome}}</p></section></main>{{> footer}}