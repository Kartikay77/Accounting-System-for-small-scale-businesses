{{> static}}{{> header}}{{> sidebar}}<main class="page-content"><div class="page-heading"><div><h1>Accounts Payable</h1><p class="muted">Record vendor bills, track due balances and post payments.</p></div></div><section class="panel"><h2>New vendor bill</h2><form method="post" action="/accounting/ap/new" class="form-grid"><label>Vendor / party<select class="form-control" name="partyId" required><option value="">Select vendor</option>{{#each parties}}<option value="{{_id}}">{{name}}</option>{{/each}}</select></label><label>Bill number<input class="form-control" name="number" required></label><label>Bill date<input class="form-control" type="date" name="date" required></label><label>Due date<input class="form-control" type="date" name="dueDate" required></label><label>Subtotal<input class="form-control" type="number" min="0" step="0.01" name="subtotal" required></label><label>GST input tax<input class="form-control" type="number" min="0" step="0.01" name="taxAmount" value="0"></label><label>Description<input class="form-control" name="description"></label><div class="actions"><button class="btn" type="submit">Post vendor bill</button></div></form></section><section class="panel table-wrap"><h2>Vendor bills</h2><table><thead><tr><th>Bill</th><th>Vendor</th><th>Date</th><th>Due</th><th>Total</th><th>Paid</th><th>Balance</th><th>Status</th><th>Payment</th></tr></thead><tbody>{{#each rows}}<tr><td>{{number}}</td><td>{{vendorName}}</td><td>{{dateText}}</td><td>{{dueDateText}}{{#if daysPastDue}} · {{daysPastDue}} days overdue{{/if}}</td><td>₹{{totalText}}</td><td>₹{{paidText}}</td><td>₹{{dueText}}</td><td>{{status}}</td><td>{{#unless isArchived}}<form method="post" action="/accounting/ap/{{_id}}/pay" class="inline-form"><input class="form-control" type="number" min="0.01" step="0.01" name="amount" placeholder="Amount"><select class="form-control" name="mode"><option>BANK_TRANSFER</option><option>CASH</option><option>UPI</option><option>CHEQUE</option><option>CARD</option><option>OTHER</option></select><input class="form-control" name="reference" placeholder="Reference"><button class="btn btn-outline" type="submit">Pay</button></form>{{/unless}}</td></tr>{{else}}<tr><td colspan="9">No vendor bills yet.</td></tr>{{/each}}</tbody></table></section></main>{{> footer}}