{{> static}}{{> header}}{{> sidebar}}<main class="page-content"><div class="page-heading"><div><h1>Balance Sheet</h1><p class="muted">Assets, liabilities and equity as of the selected date.</p></div></div><form class="panel form-grid" method="get"><label>As of<input class="form-control" type="date" name="to" value="{{to}}"></label><div class="actions"><button class="btn" type="submit">Run report</button></div></form><div class="two-column"><section class="panel"><h2>Assets</h2><table><tbody>{{#each assets}}<tr><td>{{code}} · {{name}}</td><td>₹{{balanceText}}</td></tr>{{else}}<tr><td>No assets posted</td><td>₹0.00</td></tr>{{/each}}<tr><th>Total assets</th><th>₹{{assetsTotal}}</th></tr></tbody></table></section><section class="panel"><h2>Liabilities & equity</h2><table><tbody>{{#each liabilities}}<tr><td>{{code}} · {{name}}</td><td>₹{{balanceText}}</td></tr>{{/each}}<tr><th>Liabilities</th><th>₹{{liabilitiesTotal}}</th></tr>{{#each equity}}<tr><td>{{code}} · {{name}}</td><td>₹{{balanceText}}</td></tr>{{/each}}<tr><td>Current earnings</td><td>₹{{currentEarnings}}</td></tr><tr><th>Total equity</th><th>₹{{equityTotal}}</th></tr><tr><th>Liabilities + equity</th><th>₹{{liabilitiesEquityTotal}}</th></tr></tbody></table></section></div></main>{{> footer}}