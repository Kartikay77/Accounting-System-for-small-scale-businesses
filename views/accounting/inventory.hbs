{{> static}}{{> header}}{{> sidebar}}<main class="page-content"><div class="page-heading"><div><h1>Inventory Accounting</h1><p class="muted">Review stock movements and post controlled inventory adjustments.</p></div></div><section class="panel"><h2>Inventory adjustment</h2><form method="post" action="/accounting/inventory/adjust" class="form-grid"><label>Item<select class="form-control" name="itemId" required><option value="">Select item</option>{{#each items}}<option value="{{_id}}">{{newModelName}} · Qty {{quantityOnHand}} · Cost ₹{{unitCost}}</option>{{/each}}</select></label><label>Date<input class="form-control" type="date" name="date" required></label><label>Quantity change<input class="form-control" type="number" step="0.01" name="quantityDelta" required><small>Positive adds stock; negative reduces stock.</small></label><label>Reason<input class="form-control" name="notes" required></label><div class="actions"><button class="btn" type="submit">Post adjustment</button></div></form></section><section class="panel table-wrap"><h2>Inventory ledger</h2><table><thead><tr><th>Date</th><th>Item</th><th>Type</th><th>Quantity</th><th>Unit cost</th><th>Reference</th><th>Notes</th></tr></thead><tbody>{{#each txRows}}<tr><td>{{dateText}}</td><td>{{itemName}}</td><td>{{type}}</td><td>{{quantity}}</td><td>₹{{unitCostText}}</td><td>{{referenceType}}</td><td>{{notes}}</td></tr>{{else}}<tr><td colspan="7">No inventory transactions yet.</td></tr>{{/each}}</tbody></table></section></main>{{> footer}}