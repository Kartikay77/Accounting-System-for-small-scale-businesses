{{> static}}{{> header}}{{> sidebar}}<main class="page-content"><div class="page-heading"><div><h1>Journal Entries</h1><p class="muted">Post balanced manual debits and credits. Automatic entries from invoices, receipts, bills and inventory also appear here.</p></div></div><section class="panel"><h2>Manual journal</h2><form method="post" action="/accounting/journals/new" class="form-grid"><label>Date<input class="form-control" type="date" name="date" required></label><label>Description<input class="form-control" name="description" required></label><label>Debit account<select class="form-control" name="debitAccountId" required><option value="">Select account</option>{{#each accounts}}<option value="{{_id}}">{{code}} · {{name}}</option>{{/each}}</select></label><label>Credit account<select class="form-control" name="creditAccountId" required><option value="">Select account</option>{{#each accounts}}<option value="{{_id}}">{{code}} · {{name}}</option>{{/each}}</select></label><label>Amount<input class="form-control" type="number" min="0.01" step="0.01" name="amount" required></label><div class="actions"><button class="btn" type="submit">Post journal</button></div></form></section><section class="panel table-wrap"><h2>Recent journals</h2><table><thead><tr><th>Date</th><th>Type</th><th>Description</th><th>Status</th><th>Lines</th></tr></thead><tbody>{{#each journals}}<tr><td>{{dateText}}</td><td>{{referenceType}}</td><td>{{description}}</td><td>{{status}}</td><td>{{lineText}}</td></tr>{{else}}<tr><td colspan="5">No journals posted yet.</td></tr>{{/each}}</tbody></table></section></main>{{> footer}}