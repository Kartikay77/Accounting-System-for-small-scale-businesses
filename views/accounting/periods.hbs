{{> static}}{{> header}}{{> sidebar}}<main class="page-content"><div class="page-heading"><div><h1>Financial Periods</h1><p class="muted">Close accounting periods and block future postings into closed dates.</p></div></div><section class="panel"><h2>Close a period</h2><p class="muted">Closing transfers revenue and expense balances into Owner Equity and prevents subsequent postings inside the closed date range.</p><form method="post" action="/accounting/periods/close" class="form-grid"><label>Name<input class="form-control" name="name" placeholder="FY 2026 Q4"></label><label>Start date<input class="form-control" type="date" name="startDate" required></label><label>End date<input class="form-control" type="date" name="endDate" required></label><div class="actions"><button class="btn" type="submit">Close period</button></div></form></section><section class="panel table-wrap"><h2>Periods</h2><table><thead><tr><th>Name</th><th>Start</th><th>End</th><th>Status</th><th>Closed at</th></tr></thead><tbody>{{#each periods}}<tr><td>{{name}}</td><td>{{startText}}</td><td>{{endText}}</td><td>{{status}}</td><td>{{closedAt}}</td></tr>{{else}}<tr><td colspan="5">No periods closed yet.</td></tr>{{/each}}</tbody></table></section></main>{{> footer}}