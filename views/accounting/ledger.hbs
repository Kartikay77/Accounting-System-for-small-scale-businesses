{{> static}}{{> header}}{{> sidebar}}<main class="page-content"><div class="page-heading"><div><h1>General Ledger</h1><p class="muted">All posted journal movements by account.</p></div></div><form class="panel form-grid" method="get"><label>From<input class="form-control" type="date" name="from" value="{{from}}"></label><label>To<input class="form-control" type="date" name="to" value="{{to}}"></label><div class="actions"><button class="btn" type="submit">Filter</button></div></form><section class="panel table-wrap"><table><thead><tr><th>Date</th><th>Account</th><th>Reference</th><th>Description</th><th>Debit</th><th>Credit</th><th>Running balance</th></tr></thead><tbody>{{#each rows}}<tr><td>{{dateText}}</td><td>{{accountCode}} · {{accountName}}</td><td>{{referenceType}}</td><td>{{description}}</td><td>₹{{debitText}}</td><td>₹{{creditText}}</td><td>₹{{balanceText}}</td></tr>{{else}}<tr><td colspan="7">No posted ledger activity.</td></tr>{{/each}}</tbody></table></section></main>{{> footer}}