{{> static}}{{> header}}{{> sidebar}}<main class="page-content"><div class="page-heading"><div><h1>Trial Balance</h1><p class="muted">Posted debit and credit totals by account.</p></div></div><form class="panel form-grid" method="get"><label>From<input class="form-control" type="date" name="from" value="{{from}}"></label><label>To<input class="form-control" type="date" name="to" value="{{to}}"></label><div class="actions"><button class="btn" type="submit">Filter</button></div></form><section class="panel table-wrap"><table><thead><tr><th>Code</th><th>Account</th><th>Type</th><th>Debit</th><th>Credit</th></tr></thead><tbody>{{#each rows}}<tr><td>{{code}}</td><td>{{name}}</td><td>{{type}}</td><td>₹{{debitText}}</td><td>₹{{creditText}}</td></tr>{{/each}}<tr><th colspan="3">Total</th><th>₹{{debitTotal}}</th><th>₹{{creditTotal}}</th></tr></tbody></table><p><strong>{{#if balanced}}Balanced{{else}}NOT BALANCED{{/if}}</strong></p></section></main>{{> footer}}