{{> static}}{{> header}}{{> sidebar}}<main class="page-content"><div class="page-heading"><div><h1>Edit employee salary</h1><p class="muted">Update {{entry.employeeName}}.</p></div></div><form method="post" class="panel stack"><label>Employee name<input class="form-control" name="employeeName" value="{{entry.employeeName}}" required></label><label>Monthly salary<input class="form-control" type="number" name="monthlySalary" min="0" step="0.01" value="{{entry.monthlySalary}}" required></label><div class="actions"><button class="btn" type="submit">Save changes</button><a class="btn btn-outline" href="/salary/list">Cancel</a></div></form></main>{{> footer}}
