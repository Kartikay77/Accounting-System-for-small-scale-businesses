{{> static}}{{> header}}{{> sidebar}}<main class="page-content"><div class="page-heading"><div><h1>Salary Management</h1><p class="muted">MongoDB-backed version of the salary module documented in the original React project.</p></div><a class="btn" href="/salary/new">Add employee salary</a></div><section class="metric-grid"><article class="metric"><span>Daily estimate</span><strong>₹{{dailyTotal}}</strong></article><article class="metric"><span>Monthly payroll</span><strong>₹{{monthlyTotal}}</strong></article><article class="metric"><span>Yearly payroll</span><strong>₹{{yearlyTotal}}</strong></article></section><section class="panel table-wrap"><table><thead><tr><th>Employee</th><th>Daily</th><th>Monthly</th><th>Yearly</th><th>Actions</th></tr></thead><tbody>{{#each payrollRows}}<tr><td>{{this.employeeName}}</td><td>₹{{this.dailyDisplay}}</td><td>₹{{this.monthlyDisplay}}</td><td>₹{{this.yearlyDisplay}}</td><td class="actions-cell"><a href="/salary/edit/{{this._id}}">Edit</a><form method="post" action="/salary/delete/{{this._id}}" data-confirm="Archive this salary entry?"><button class="link-button danger" type="submit">Archive</button></form></td></tr>{{else}}<tr><td colspan="5">No salary entries yet.</td></tr>{{/each}}</tbody></table></section></main>{{> footer}}
