{{> static}}{{> header}}{{> sidebar}}<main class="page-content"><div class="page-heading"><div><h1>Invoices</h1><p class="muted">Issued invoices for {{companyName}}.</p></div><a class="btn" href="/invoice/new">New invoice</a></div><section class="panel table-wrap"><table><thead><tr><th>No.</th><th>Date</th><th>Party</th><th>City</th><th>Total</th><th>Status</th><th>Actions</th></tr></thead><tbody>{{#each invoiceRows}}<tr><td>{{this.number}}</td><td>{{this.date}}</td><td>{{this.partyName}}</td><td>{{this.partyCity}}</td><td>₹{{this.totalAmount}}</td><td><span class="badge">{{this.status}}</span></td><td class="actions-cell"><a href="/invoice/print/{{this._id}}">Print</a><form method="post" action="/invoice/delete/{{this._id}}" data-confirm="Void this invoice?"><button class="link-button danger" type="submit">Void</button></form></td></tr>{{else}}<tr><td colspan="7">No invoices yet.</td></tr>{{/each}}</tbody></table></section></main>{{> footer}}
