{{> static}}{{> header}}{{> sidebar}}<main class="page-content"><div class="page-heading"><div><h1>New invoice</h1><p class="muted">Totals are recalculated on the server before saving. Serial numbers can be entered per line, separated by commas or new lines.</p></div></div>{{#unless parties.length}}<div class="notice">Add a <a href="/party/new">party</a> before creating an invoice.</div>{{/unless}}{{#unless items.length}}<div class="notice">Add an <a href="/item/new">item</a> before creating an invoice.</div>{{/unless}}<form method="post" class="panel stack" id="invoice-form"><div class="form-grid"><label>Invoice number<input class="form-control" name="number" required></label><label>Date<input class="form-control" type="date" name="date" required></label><label class="span-2">Party<select class="form-control" name="partyId" required><option value="">Select party</option>{{#each parties}}<option value="{{this._id}}">{{this.name}} — {{this.city}}</option>{{/each}}</select></label></div><div class="section-heading"><h2>Line items</h2><button type="button" class="btn btn-outline" id="add-line">Add line</button></div><div id="invoice-lines"></div><template id="invoice-line-template"><div class="invoice-line"><label>Item<select class="form-control line-item" required><option value="">Select item</option>{{#each items}}<option value="{{this.newModelName}}" data-price="{{this.price}}" data-tax="{{this.tax}}">{{this.newModelName}} · ₹{{this.price}} · {{this.tax}}% GST</option>{{/each}}</select></label><label>Quantity<input class="form-control line-qty" type="number" min="0.01" step="0.01" value="1" required></label><label>Rate<input class="form-control line-rate" type="number" min="0" step="0.01" required></label><label>Serial numbers<textarea class="form-control line-serials" rows="2" placeholder="SN001, SN002"></textarea></label><div><span class="field-label">Line estimate</span><strong class="line-total">₹0.00</strong></div><button type="button" class="icon-button remove-line" aria-label="Remove line">×</button></div></template><div class="invoice-summary"><span>Estimated total</span><strong id="invoice-estimate">₹0.00</strong></div><div class="form-grid"><label>E-way bill<input class="form-control" name="eWay"></label><label class="span-2">Narration<textarea class="form-control" name="narration" rows="3"></textarea></label></div>{{#if parties.length}}{{#if items.length}}<button class="btn" type="submit">Create invoice</button>{{else}}<button class="btn" type="button" disabled>Add an item first</button>{{/if}}{{else}}<button class="btn" type="button" disabled>Add a party first</button>{{/if}}</form></main>{{> footer}}
