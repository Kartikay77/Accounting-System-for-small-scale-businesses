{{> static}}{{> header}}{{> sidebar}}<main class="page-content"><div class="page-heading"><div><h1>Edit item</h1><p class="muted">Update {{item.newModelName}}. Stock quantity is controlled through accounting inventory adjustments.</p></div></div><form method="post" class="panel stack"><div class="form-grid"><label>Model / item name<input class="form-control" name="newModelName" value="{{item.newModelName}}" required></label><label>Brand / company<input class="form-control" name="companyName" value="{{item.companyName}}"></label><label>HSN code<input class="form-control" name="hsn" value="{{item.hsn}}"></label><label>Item type<input class="form-control" name="itemType" value="{{item.itemType}}"></label><label>GST rate %<input class="form-control" type="number" name="tax" min="0" max="100" step="0.01" value="{{item.tax}}"></label><label>Selling price<input class="form-control" type="number" name="price" min="0" step="0.01" value="{{item.price}}"></label><label>Unit cost for COGS<input class="form-control" type="number" name="unitCost" min="0" step="0.01" value="{{item.unitCost}}"></label><label>Quantity on hand<input class="form-control" type="number" value="{{item.quantityOnHand}}" readonly><small><a href="/accounting/inventory">Use Inventory Adjustments</a> to change stock.</small></label><label>Reorder level<input class="form-control" type="number" name="reorderLevel" min="0" step="0.01" value="{{item.reorderLevel}}"></label></div><div class="actions"><button class="btn" type="submit">Save item</button><a class="btn btn-outline" href="/item/list">Cancel</a></div></form></main>{{> footer}}
