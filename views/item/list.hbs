{{> static}}{{> header}}{{> sidebar}}<main class="page-content"><div class="page-heading"><div><h1>Items</h1><p class="muted">Products and inventory master data.</p></div><a class="btn" href="/item/new">New item</a></div><section class="panel table-wrap"><table><thead><tr><th>Model</th><th>Brand</th><th>HSN</th><th>Type</th><th>Tax %</th><th>Price</th><th>On hand</th><th>Actions</th></tr></thead><tbody>{{#each items}}<tr><td>{{this.newModelName}}</td><td>{{this.companyName}}</td><td>{{this.hsn}}</td><td>{{this.itemType}}</td><td>{{this.tax}}</td><td>{{this.price}}</td><td>{{this.quantityOnHand}}</td><td class="actions-cell"><a href="/item/edit/{{this._id}}">Edit</a><form method="post" action="/item/delete/{{this._id}}" data-confirm="Archive this item?"><button class="link-button danger" type="submit">Archive</button></form></td></tr>{{else}}<tr><td colspan="8">No items yet.</td></tr>{{/each}}</tbody></table></section></main>{{> footer}}
