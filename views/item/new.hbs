{{> static}}{{> header}}{{> sidebar}}<main class="page-content"><div class="page-heading"><div><h1>New item</h1><p class="muted">Add product master data and starting inventory.</p></div></div><form method="post" class="panel stack"><div class="form-grid"><label>Model / item name<input class="form-control" name="newModelName" required></label><label>Brand / company<input class="form-control" name="companyName"></label><label>HSN code<input class="form-control" name="hsn"></label><label>Item type<input class="form-control" name="itemType"></label><label>GST rate %<input class="form-control" type="number" name="tax" min="0" max="100" step="0.01" value="0"></label><label>Unit price<input class="form-control" type="number" name="price" min="0" step="0.01" value="0"></label><label>Quantity on hand<input class="form-control" type="number" name="quantityOnHand" min="0" step="0.01" value="0"></label><label>Reorder level<input class="form-control" type="number" name="reorderLevel" min="0" step="0.01" value="0"></label></div><div class="actions"><button class="btn" type="submit">Create item</button><a class="btn btn-outline" href="/item/list">Cancel</a></div></form></main>{{> footer}}
