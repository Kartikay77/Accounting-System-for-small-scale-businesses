{{> static}}
{{> header}}
<main class="landing">
  <section class="hero">
    <div>
      <span class="eyebrow">Small-business finance demo</span>
      <h1>Invoices, customers, items and company records in one place.</h1>
      <p>Easy Accounting is a runnable Node.js, Express and MongoDB application with authentication, company-scoped data, GST-aware invoice calculation and printable invoices.</p>
      <div class="actions"><a class="btn" href="/register">Create account</a><a class="btn btn-outline" href="/login">Login</a></div>
    </div>
    <div class="hero-card">
      <strong>Core workflow</strong>
      <ol><li>Create or select a company</li><li>Add a customer/party</li><li>Add inventory items</li><li>Create an invoice</li><li>Print and review invoices</li></ol>
    </div>
  </section>
  <section class="screenshot-grid">
    <img src="/media/landing.jpg" alt="Original Easy Accounting landing page screenshot">
    <img src="/media/invoice creation.jpg" alt="Invoice creation screenshot">
    <img src="/media/invoice printing.jpg" alt="Invoice printing screenshot">
  </section>
</main>
{{> footer}}
