{{> static}}
{{> header}}
<main class="auth-shell"><section class="auth-card"><h1>Create account</h1><p class="muted">Start with your user account, then create a company.</p><form method="post" action="/user/register" class="stack"><label>Name<input class="form-control" type="text" name="username" required minlength="2" autocomplete="name"></label><label>Email<input class="form-control" type="email" name="email" required autocomplete="email"></label><label>Password<input class="form-control" type="password" name="password" required minlength="8" autocomplete="new-password"></label><button class="btn" type="submit">Register</button></form><p class="muted">Already registered? <a href="/login">Login</a></p></section></main>
{{> footer}}
