{{> static}}{{> header}}{{> sidebar}}<main class="page-content"><div class="page-heading"><div><h1>Edit party</h1><p class="muted">Update {{party.name}}.</p></div></div><form method="post" class="panel stack"><div class="form-grid"><label>Name<input class="form-control" name="name" value="{{party.name}}" required></label><label>GSTIN<input class="form-control" name="gstin" value="{{party.gstin}}"></label><label class="span-2">Address<input class="form-control" name="address" value="{{party.address}}"></label><label>City<input class="form-control" name="city" value="{{party.city}}"></label><label>State<input class="form-control" name="state" value="{{party.state}}"></label><label>Pincode<input class="form-control" name="pincode" value="{{party.pincode}}"></label><label>Country<input class="form-control" name="country" value="{{party.country}}"></label><label>Contact person<input class="form-control" name="contactPersonName" value="{{party.contactPersonName}}"></label><label>Email<input class="form-control" type="email" name="email" value="{{party.email}}"></label><label>Mobile<input class="form-control" name="mobileNumber" value="{{party.mobileNumber}}"></label><label>Alternate mobile<input class="form-control" name="altMobileNumber" value="{{party.altMobileNumber}}"></label></div><div class="actions"><button class="btn" type="submit">Save party</button><a class="btn btn-outline" href="/party/list">Cancel</a></div></form></main>{{> footer}}
