{{> static}}{{> header}}{{> sidebar}}<main class="page-content"><div class="page-heading"><div><h1>Parties</h1><p class="muted">Customers and sales counterparties for {{companyName}}.</p></div><a class="btn" href="/party/new">New party</a></div><section class="panel table-wrap"><table><thead><tr><th>Name</th><th>City</th><th>GSTIN</th><th>Contact</th><th>Mobile</th><th>Email</th><th>Actions</th></tr></thead><tbody>{{#each parties}}<tr><td>{{this.name}}</td><td>{{this.city}}</td><td>{{this.gstin}}</td><td>{{this.contactPersonName}}</td><td>{{this.mobileNumber}}</td><td>{{this.email}}</td><td class="actions-cell"><a href="/party/edit/{{this._id}}">Edit</a><form method="post" action="/party/delete/{{this._id}}" data-confirm="Archive this party?"><button class="link-button danger" type="submit">Archive</button></form></td></tr>{{else}}<tr><td colspan="7">No parties yet.</td></tr>{{/each}}</tbody></table></section></main>{{> footer}}
