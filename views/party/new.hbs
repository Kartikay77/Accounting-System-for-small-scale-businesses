{{> static}}{{> header}}{{> sidebar}}<main class="page-content"><div class="page-heading"><div><h1>New party</h1><p class="muted">Add a customer or sales counterparty for {{companyName}}.</p></div></div><form method="post" class="panel stack"><div class="form-grid"><label>Name<input class="form-control" name="name" required></label><label>GSTIN<input class="form-control" name="gstin"></label><label class="span-2">Address<input class="form-control" name="address"></label><label>City<input class="form-control" name="city"></label><label>State<input class="form-control" name="state"></label><label>Pincode<input class="form-control" name="pincode"></label><label>Country<input class="form-control" name="country" value="India"></label><label>Contact person<input class="form-control" name="contactPersonName"></label><label>Email<input class="form-control" type="email" name="email"></label><label>Mobile<input class="form-control" name="mobileNumber"></label><label>Alternate mobile<input class="form-control" name="altMobileNumber"></label></div><div class="actions"><button class="btn" type="submit">Create party</button><a class="btn btn-outline" href="/party/list">Cancel</a></div></form></main>{{> footer}}
