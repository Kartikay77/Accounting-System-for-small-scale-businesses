{{> static}}{{> header}}{{> sidebar}}<main class="page-content"><div class="page-heading"><div><h1>Edit company</h1><p class="muted">Update {{company.name}}.</p></div></div><form method="post" class="panel stack"><div class="form-grid"><label>Company name<input class="form-control" name="name" value="{{company.name}}" required></label><label>Email<input class="form-control" type="email" name="email" value="{{company.email}}"></label><label>GSTIN<input class="form-control" name="gstin" value="{{company.gstin}}"></label><label>Country<input class="form-control" name="country" value="{{company.country}}"></label><label class="span-2">Address<input class="form-control" name="address" value="{{company.address}}"></label><label>City<input class="form-control" name="city" value="{{company.city}}"></label><label>State<input class="form-control" name="state" value="{{company.state}}"></label><label>Pincode<input class="form-control" name="pincode" value="{{company.pincode}}"></label><label>Bank name<input class="form-control" name="bankName" value="{{company.bankName}}"></label><label>Branch<input class="form-control" name="branch" value="{{company.branch}}"></label><label>IFSC<input class="form-control" name="ifsc" value="{{company.ifsc}}"></label><label>Account number<input class="form-control" name="accountNumber" value="{{company.accountNumber}}"></label></div><div class="actions"><button class="btn" type="submit">Save company</button><a class="btn btn-outline" href="/company/list">Cancel</a></div></form></main>{{> footer}}
