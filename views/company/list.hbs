{{> static}}{{> header}}{{> sidebar}}<main class="page-content"><div class="page-heading"><div><h1>Companies</h1><p class="muted">Your business entities.</p></div><a class="btn" href="/company/new">New company</a></div><section class="panel table-wrap"><table><thead><tr><th>Name</th><th>GSTIN</th><th>City</th><th>Bank</th><th>IFSC</th><th>Actions</th></tr></thead><tbody>{{#each companies}}<tr><td>{{this.name}}</td><td>{{this.gstin}}</td><td>{{this.city}}</td><td>{{this.bankName}}</td><td>{{this.ifsc}}</td><td class="actions-cell"><form method="post" action="/company/select"><input type="hidden" name="companyId" value="{{this._id}}"><button class="link-button" type="submit">Select</button></form><a href="/company/edit/{{this._id}}">Edit</a><form method="post" action="/company/delete/{{this._id}}" data-confirm="Archive this company?"><button class="link-button danger" type="submit">Archive</button></form></td></tr>{{else}}<tr><td colspan="6">No companies yet.</td></tr>{{/each}}</tbody></table></section></main>{{> footer}}
