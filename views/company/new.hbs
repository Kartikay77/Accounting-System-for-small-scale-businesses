{{> static}}{{> header}}{{> sidebar}}<main class="page-content"><div class="page-heading"><div><h1>New company</h1><p class="muted">Create a business entity. The first company becomes active automatically.</p></div></div><form method="post" class="panel stack"><div class="form-grid"><label>Company name<input class="form-control" name="name" required></label><label>Email<input class="form-control" type="email" name="email"></label><label>GSTIN<input class="form-control" name="gstin" maxlength="15"></label><label>Country<input class="form-control" name="country" value="India"></label><label class="span-2">Address<input class="form-control" name="address"></label><label>City<input class="form-control" name="city"></label><label>State<input class="form-control" name="state"></label><label>Pincode<input class="form-control" name="pincode"></label><label>Bank name<input class="form-control" name="bankName"></label><label>Branch<input class="form-control" name="branch"></label><label>IFSC<input class="form-control" name="ifsc"></label><label>Account number<input class="form-control" name="accountNumber"></label></div><div class="actions"><button class="btn" type="submit">Create company</button><a class="btn btn-outline" href="/company/list">Cancel</a></div></form></main>{{> footer}}
