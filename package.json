{
  "name": "small-business-accounting-system",
  "version": "2.3.0",
  "private": true,
  "description": "Runnable small-business invoicing and accounting demo built with Node.js, Express, Handlebars, React and MongoDB.",
  "main": "app.js",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node ./bin/www",
    "dev": "nodemon ./bin/www",
    "seed": "node ./scripts/seed.js",
    "build:react": "node ./scripts/build-react.js",
    "test": "jest --runInBand",
    "test:integration": "RUN_INTEGRATION=1 jest test/app.integration.test.js --runInBand",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "npm test && npm run lint"
  },
  "repository": { "type": "git", "url": "https://github.com/Kartikay77/Accounting-System-for-small-scale-businesses.git" },
  "author": "Kartikay Gupta",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "connect-mongo": "^6.0.0",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "handlebars": "^4.7.10",
    "hbs": "^4.3.1",
    "helmet": "^8.3.0",
    "mongoose": "8.24.5"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "jest": "^30.0.0",
    "nodemon": "^3.1.0",
    "prettier": "^3.0.0",
    "supertest": "^7.0.0"
  },
  "overrides": {
  "hbs": {
    "handlebars": "4.7.10"
  }
}
}
